# HouseSigma credentials. Either provide email+password, OR provide a token
# captured from your logged-in browser session (see README "Network capture").
HOUSESIGMA_EMAIL=
HOUSESIGMA_PASSWORD=

# Optional: paste a bearer token from a live browser session if login flow fails
# (open DevTools -> Network -> any /bkv2/api/ request -> copy the `token` field
# or the Authorization header value).
HOUSESIGMA_TOKEN=

# Optional: override the base URL (in case HouseSigma moves endpoints).
HOUSESIGMA_BASE_URL=https://housesigma.com

# Optional: where to persist the session token between runs.
HOUSESIGMA_SESSION_FILE=.housesigma-session.json

# Optional: verbose request logging to stderr.
HOUSESIGMA_DEBUG=0
